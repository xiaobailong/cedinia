import { Fonts } from "../globals/fonts.slint";
import { CediniaColors } from "../globals/colors.slint";
import { AppState } from "../globals/app_state.slint";
import { Translations } from "../globals/translations.slint";
import { ScrimDialog } from "../components/scrim_dialog.slint";
import { TouchButton } from "../components/buttons/touch_button.slint";
import { ScrollView, Slider } from "std-widgets.slint";

enum CompareMode { Normal, Split, Overlay, Diff }

component CompareIconBtn inherits Rectangle {
    in property <image>  icon;
    in property <bool>   active:  false;
    in property <bool>   enabled: true;
    in property <bool>   close_btn: false;
    callback clicked;

    width:  52px;
    height: 44px;
    border-radius: 10px;
    background: ta.has-hover && root.enabled
        ? (root.close_btn ? CediniaColors.compare_close_bg_hover
          : root.active ? CediniaColors.accent.brighter(0.15) : CediniaColors.bg_surface)
        : (root.close_btn ? CediniaColors.compare_close_bg
          : root.active ? CediniaColors.accent_muted : transparent);
    animate background { duration: 100ms; }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    Image {
        source: root.icon;
        colorize: root.enabled
            ? (root.close_btn ? CediniaColors.compare_close_icon
              : root.active ? CediniaColors.accent_light : CediniaColors.text_secondary)
            : CediniaColors.text_disabled;
        width:  24px;
        height: 24px;
        horizontal-alignment: ImageHorizontalAlignment.center;
        vertical-alignment:   ImageVerticalAlignment.center;
    }
}

// Single-image viewer - opened by tapping an image of the compare view.  Swipe
// left/right to walk through the group, long-press for the delete bar at the bottom.
component CompareFullscreen inherits Rectangle {
    // Chrome (top bar, info line, delete bar) is hidden by a plain tap.
    property <bool> chrome_visible: true;

    // Long-press bookkeeping - same pattern as FileRow / GalleryImageCell.
    property <bool>   lp_fired: false;
    property <bool>   _lp_active: false;
    property <length> _press_x: 0px;
    property <length> _press_y: 0px;

    property <int>  count: AppState.compare_images.length;
    property <int>  idx:   AppState.compare_fullscreen_idx;
    property <bool> idx_valid: idx >= 0 && idx < count;

    // Watch ta.pressed so an up/cancel/gesture-steal always disarms the long-press.
    property <bool> _ta_pressed_watch: ta.pressed;
    changed _ta_pressed_watch => {
        if (!_ta_pressed_watch) {
            root._lp_active = false;
            lp_timer.running = false;
        }
    }

    background: CediniaColors.image_viewer_bg;

    // Swipe navigation.  The recognizer has to wrap the touch area rather than sit next to
    // it: a press is forwarded to the recognizer's children only after a 100ms delay, and
    // the delayed press is replayed into the recognizer's own children, so a recognizer
    // declared as a sibling would never see it.  It also has to be declared before the
    // chrome, because once a drag passes the built-in 8 px threshold the recognizer stops
    // forwarding pointer events - declared after the chrome it would swallow every press on
    // the chrome buttons.  Both directions go through the same signed travel between the
    // pressed and the released position, so dragging leftwards shows the next image.
    sgr := SwipeGestureHandler {
        handle-swipe-left: true;
        handle-swipe-right: true;
        swiped => {
            if (self.current-position.x - self.pressed-position.x <= -60px) {
                if (root.idx + 1 < root.count) { AppState.compare_fullscreen_open(root.idx + 1); }
            } else if (self.current-position.x - self.pressed-position.x >= 60px) {
                if (root.idx > 0) { AppState.compare_fullscreen_open(root.idx - 1); }
            }
        }

        // Fills the viewer, so a tap anywhere on the image toggles the chrome and a
        // long-press opens the delete bar.
        ta := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down) {
                    root._press_x = self.mouse-x;
                    root._press_y = self.mouse-y;
                    root._lp_active = true;
                    lp_timer.restart();
                    lp_timer.running = true;
                } else if (e.kind == PointerEventKind.up) {
                    root._lp_active = false;
                    lp_timer.running = false;
                    if (root.lp_fired) {
                        // The long-press already opened the delete bar - swallow this tap.
                        root.lp_fired = false;
                    } else if (AppState.compare_fullscreen_delete_visible) {
                        AppState.compare_fullscreen_delete_visible = false;
                    } else {
                        root.chrome_visible = !root.chrome_visible;
                    }
                } else if (e.kind == PointerEventKind.cancel) {
                    // A recognised swipe ends the press here instead of with an up, so the
                    // flags that up would have cleared have to be cleared here as well - a
                    // stale lp_fired would otherwise swallow the next tap.
                    root._lp_active = false;
                    root.lp_fired = false;
                    lp_timer.running = false;
                }
            }
            // Fires while the finger is held down and moving.
            moved => {
                // Any real movement means the finger is dragging, not long-pressing.
                if (self.mouse-x - root._press_x > 12px || root._press_x - self.mouse-x > 12px
                        || self.mouse-y - root._press_y > 12px || root._press_y - self.mouse-y > 12px) {
                    root._lp_active = false;
                    lp_timer.running = false;
                }
            }
        }
    }

    lp_timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            if (!root._lp_active) { return; }
            root._lp_active = false;
            root.lp_fired = true;
            AppState.compare_fullscreen_delete_visible = true;
        }
    }

    Image {
        width: parent.width; height: parent.height;
        source: AppState.compare_fullscreen_image;
        image-fit: ImageFit.contain;
    }

    // Top bar - needs an explicit y, otherwise the default geometry centres it in the viewer
    if root.chrome_visible: Rectangle {
        x: 0; y: 0;
        height: 56px;
        background: CediniaColors.bg_elevated;

        HorizontalLayout {
            padding-left: 6px; padding-right: 6px;
            padding-top: 6px; padding-bottom: 6px;
            spacing: 8px;

            CompareIconBtn {
                icon:      @image-url("../../icons/cedinia_compare_back.svg");
                close_btn: true;
                clicked => { AppState.compare_fullscreen_close(); }
            }

            Text {
                text: (root.idx + 1) + " / " + root.count;
                color: CediniaColors.text_secondary;
                font-size: Fonts.body_lg;
                vertical-alignment: TextVerticalAlignment.center;
            }

            Rectangle { horizontal-stretch: 1.0; }

            // Which side of the compare view this image is currently assigned to.
            if root.idx_valid && root.idx == AppState.compare_left_idx: Rectangle {
                width: 30px; height: 26px;
                border-radius: 5px;
                background: CediniaColors.accent;
                Text {
                    text: "L";
                    color: CediniaColors.fg_on_accent;
                    font-size: Fonts.body; font-weight: Fonts.bold;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment:   TextVerticalAlignment.center;
                }
            }
            if root.idx_valid && root.idx == AppState.compare_right_idx: Rectangle {
                width: 30px; height: 26px;
                border-radius: 5px;
                background: CediniaColors.compare_right_mark;
                Text {
                    text: "R";
                    color: CediniaColors.fg_on_accent;
                    font-size: Fonts.body; font-weight: Fonts.bold;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment:   TextVerticalAlignment.center;
                }
            }
        }

        Rectangle {
            x: 0; y: parent.height - 1px;
            width: parent.width; height: 1px;
            background: CediniaColors.divider;
        }
    }

    // Score controls and file info of the displayed image.  The score is kept by
    // tapping the number itself, so the default score needs no +/- round trip.
    if root.chrome_visible && root.idx_valid && !AppState.compare_fullscreen_delete_visible: Rectangle {
        y: parent.height - self.height;
        height: fs_bottom.preferred-height;
        background: CediniaColors.bg_elevated;

        Rectangle {
            x: 0; y: 0; width: parent.width; height: 1px;
            background: CediniaColors.divider;
        }

        fs_bottom := VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 56px;

                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px;
                    spacing: 8px;

                    Text {
                        horizontal-stretch: 1.0;
                        vertical-alignment: TextVerticalAlignment.center;
                        text: AppState.compare_images[root.idx].rated
                            ? Translations.compare_score_progress_text + " " + AppState.compare_rated_count + " / " + root.count
                            : Translations.compare_score_accept_hint_text;
                        color: AppState.compare_images[root.idx].rated ? CediniaColors.text_secondary : CediniaColors.accent_light;
                        font-size: Fonts.caption;
                        overflow: TextOverflow.elide; wrap: no-wrap;
                    }

                    // Lower score
                    Rectangle {
                        width: 46px; height: 40px;
                        border-radius: 9px;
                        background: score_minus_ta.has-hover ? CediniaColors.bg_surface : transparent;
                        score_minus_ta := TouchArea {
                            enabled: AppState.compare_images[root.idx].score > AppState.compare_score_min;
                            clicked => { AppState.compare_score_step(root.idx, -1); }
                        }
                        Text {
                            text: "-";
                            color: AppState.compare_images[root.idx].score > AppState.compare_score_min
                                ? CediniaColors.text_primary : CediniaColors.text_disabled;
                            font-size: Fonts.title; font-weight: Fonts.bold;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            vertical-alignment:   TextVerticalAlignment.center;
                        }
                    }

                    // The number keeps the score shown, so a 5 needs no +/- round trip
                    Rectangle {
                        width: 66px; height: 40px;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: AppState.compare_images[root.idx].rated ? CediniaColors.accent : CediniaColors.border;
                        background: score_value_ta.has-hover ? CediniaColors.bg_surface.brighter(0.15) : CediniaColors.bg_surface;
                        score_value_ta := TouchArea {
                            clicked => { AppState.compare_score_step(root.idx, 0); }
                        }
                        Text {
                            text: "" + AppState.compare_images[root.idx].score;
                            color: AppState.compare_images[root.idx].rated ? CediniaColors.text_primary : CediniaColors.text_secondary;
                            font-size: Fonts.title_lg; font-weight: Fonts.bold;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            vertical-alignment:   TextVerticalAlignment.center;
                        }
                    }

                    // Higher score
                    Rectangle {
                        width: 46px; height: 40px;
                        border-radius: 9px;
                        background: score_plus_ta.has-hover ? CediniaColors.bg_surface : transparent;
                        score_plus_ta := TouchArea {
                            enabled: AppState.compare_images[root.idx].score < AppState.compare_score_max;
                            clicked => { AppState.compare_score_step(root.idx, 1); }
                        }
                        Text {
                            text: "+";
                            color: AppState.compare_images[root.idx].score < AppState.compare_score_max
                                ? CediniaColors.text_primary : CediniaColors.text_disabled;
                            font-size: Fonts.title; font-weight: Fonts.bold;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            vertical-alignment:   TextVerticalAlignment.center;
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: CediniaColors.divider;
            }

            VerticalLayout {
                padding-left: 12px; padding-right: 12px;
                padding-top: 6px; padding-bottom: 8px;
                spacing: 2px;

                Text {
                    text: AppState.compare_images[root.idx].name;
                    color: CediniaColors.text_primary;
                    font-size: Fonts.body;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    overflow: TextOverflow.elide; wrap: no-wrap;
                }
                Text {
                    text: AppState.compare_images[root.idx].size + "  " + AppState.compare_images[root.idx].dims;
                    color: CediniaColors.text_secondary;
                    font-size: Fonts.micro;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    overflow: TextOverflow.elide; wrap: no-wrap;
                }
            }
        }
    }

    // Delete bar, opened by a long-press
    if AppState.compare_fullscreen_delete_visible: Rectangle {
        y: parent.height - self.height;
        height: 72px;
        background: CediniaColors.bg_elevated;

        Rectangle {
            x: 0; y: 0; width: parent.width; height: 1px;
            background: CediniaColors.divider;
        }

        HorizontalLayout {
            padding: 10px;
            spacing: 8px;

            Text {
                horizontal-stretch: 1.0;
                text: root.idx_valid ? AppState.compare_images[root.idx].name : "";
                color: CediniaColors.text_secondary;
                font-size: Fonts.body;
                overflow: TextOverflow.elide; wrap: no-wrap;
                vertical-alignment: TextVerticalAlignment.center;
            }

            TouchButton {
                label: Translations.delete_text;
                min_h: 44px;
                bg: CediniaColors.danger;
                fg: CediniaColors.fg_on_danger;
                clicked => { AppState.compare_delete_current(); }
            }
        }
    }

    if AppState.compare_fullscreen_loading: Text {
        text: Translations.compare_loading_text;
        color: CediniaColors.text_secondary;
        font-size: Fonts.subtitle;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment:   TextVerticalAlignment.center;
    }
}

export component ImageCompareOverlay inherits Rectangle {

    private property <CompareMode> compare_mode: CompareMode.Normal;
    private property <bool>  info_visible:  false;
    // Single slider value shared by Split and Overlay modes so the knob
    // position always matches the visual effect when switching between them.
    private property <float> slider_value:  0.5;

    private property <bool> left_valid:
        AppState.compare_left_idx >= 0 &&
        AppState.compare_left_idx < AppState.compare_images.length;
    private property <bool> right_valid:
        AppState.compare_right_idx >= 0 &&
        AppState.compare_right_idx < AppState.compare_images.length;

    // Compare actual loaded pixel dimensions - avoids false positives from
    // differing display-string formatting (e.g. empty dims for reference images).
    private property <bool> res_mismatch:
        AppState.compare_left_image.width > 0 &&
        AppState.compare_right_image.width > 0 &&
        (AppState.compare_left_image.width  != AppState.compare_right_image.width ||
         AppState.compare_left_image.height != AppState.compare_right_image.height);

    background: CediniaColors.bg_primary;

    // Auto-compute diff when loading finishes or images change while in diff mode.
    property <bool> _loading_watch: AppState.compare_loading;
    changed _loading_watch => {
        if (!_loading_watch && compare_mode == CompareMode.Diff) {
            AppState.compare_compute_diff();
        }
    }
    property <int> _left_watch: AppState.compare_left_idx;
    changed _left_watch => {
        if (compare_mode == CompareMode.Diff) { AppState.compare_compute_diff(); }
    }
    property <int> _right_watch: AppState.compare_right_idx;
    changed _right_watch => {
        if (compare_mode == CompareMode.Diff) { AppState.compare_compute_diff(); }
    }

    VerticalLayout {
        spacing: 0px;

        // Top action bar
        Rectangle {
            height: 56px;
            background: CediniaColors.bg_elevated;

            HorizontalLayout {
                padding-left:  6px;
                padding-right: 6px;
                padding-top:   6px;
                padding-bottom: 6px;
                spacing: 2px;

                // Prev group (far left)
                CompareIconBtn {
                    icon: @image-url("../../icons/cedinia_compare_prev.svg");
                    clicked => { AppState.compare_prev_group(); }
                }

                Rectangle { horizontal-stretch: 1.0; }

                // Swap
                CompareIconBtn {
                    icon: @image-url("../../icons/cedinia_compare_swap.svg");
                    clicked => { AppState.compare_swap(); }
                }

                // Close / Back (center, blue)
                CompareIconBtn {
                    icon:      @image-url("../../icons/cedinia_compare_back.svg");
                    close_btn: true;
                    clicked => {
                        AppState.compare_fullscreen_visible = false;
                        AppState.compare_fullscreen_delete_visible = false;
                        AppState.compare_visible = false;
                        root.compare_mode = CompareMode.Normal;
                        root.info_visible = false;
                    }
                }

                // Info toggle
                CompareIconBtn {
                    icon:   @image-url("../../icons/cedinia_info.svg");
                    active: root.info_visible;
                    clicked => { root.info_visible = !root.info_visible; }
                }

                Rectangle { horizontal-stretch: 1.0; }

                // Next group (far right)
                CompareIconBtn {
                    icon: @image-url("../../icons/cedinia_compare_next.svg");
                    clicked => { AppState.compare_next_group(); }
                }
            }

            // Bottom border
            Rectangle {
                x: 0; y: parent.height - 1px;
                width: parent.width; height: 1px;
                background: CediniaColors.divider;
            }
        }

        // Resolution mismatch warning (diff mode only)
        if res_mismatch && compare_mode == CompareMode.Diff: Rectangle {
            height: 26px;
            background: CediniaColors.compare_warn_banner;
            Text {
                text: Translations.compare_res_mismatch_text;
                color: CediniaColors.warning;
                font-size: Fonts.micro;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment:   TextVerticalAlignment.center;
                overflow: TextOverflow.elide;
            }
        }

        // Main image area
        main_area := Rectangle {
            vertical-stretch: 1.0;
            clip: true;
            background: CediniaColors.image_viewer_bg;

            // Normal: side-by-side
            if compare_mode == CompareMode.Normal: Rectangle {
                width: parent.width; height: parent.height;

                // Left image
                Rectangle {
                    x: 0; y: 0;
                    width: parent.width / 2;
                    height: parent.height;
                    clip: true;
                    background: CediniaColors.bg_surface;

                    Image {
                        width: parent.width; height: parent.height;
                        source: AppState.compare_left_image;
                        image-fit: ImageFit.contain;
                    }

                    // Tap to review this image on its own; swipe and long-press work there.
                    TouchArea {
                        clicked => { if (left_valid) { AppState.compare_fullscreen_open(AppState.compare_left_idx); } }
                    }

                    // Checked indicator (bottom-right corner)
                    if left_valid: Rectangle {
                        x: parent.width - 44px;
                        y: parent.height - 44px;
                        width: 36px; height: 36px;
                        border-radius: 18px;
                        background: AppState.compare_images[AppState.compare_left_idx].checked
                            ? CediniaColors.accent : CediniaColors.bg_elevated;
                        border-width: 2px;
                        border-color: AppState.compare_images[AppState.compare_left_idx].checked
                            ? CediniaColors.accent : CediniaColors.border;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: CediniaColors.shadow_sm;
                        animate background { duration: 100ms; }
                        TouchArea {
                            clicked => { AppState.compare_toggle_checkbox(AppState.compare_left_idx); }
                        }
                        Text {
                            text: AppState.compare_images[AppState.compare_left_idx].checked ? Translations.ok_text : "";
                            color: CediniaColors.fg_on_accent;
                            font-size: Fonts.body_lg; font-weight: Fonts.bold;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            vertical-alignment:   TextVerticalAlignment.center;
                        }
                    }
                }

                // Divider
                Rectangle {
                    x: parent.width / 2; y: 0;
                    width: 1px; height: parent.height;
                    background: CediniaColors.divider;
                }

                // Right image
                Rectangle {
                    x: parent.width / 2 + 1px; y: 0;
                    width: parent.width / 2 - 1px;
                    height: parent.height;
                    clip: true;
                    background: CediniaColors.bg_surface;

                    Image {
                        width: parent.width; height: parent.height;
                        source: AppState.compare_right_image;
                        image-fit: ImageFit.contain;
                    }

                    // Tap to review this image on its own; swipe and long-press work there.
                    TouchArea {
                        clicked => { if (right_valid) { AppState.compare_fullscreen_open(AppState.compare_right_idx); } }
                    }

                    // Checked indicator (bottom-left corner)
                    if right_valid: Rectangle {
                        x: 8px;
                        y: parent.height - 44px;
                        width: 36px; height: 36px;
                        border-radius: 18px;
                        background: AppState.compare_images[AppState.compare_right_idx].checked
                            ? CediniaColors.accent : CediniaColors.bg_elevated;
                        border-width: 2px;
                        border-color: AppState.compare_images[AppState.compare_right_idx].checked
                            ? CediniaColors.accent : CediniaColors.border;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: CediniaColors.shadow_sm;
                        animate background { duration: 100ms; }
                        TouchArea {
                            clicked => { AppState.compare_toggle_checkbox(AppState.compare_right_idx); }
                        }
                        Text {
                            text: AppState.compare_images[AppState.compare_right_idx].checked ? Translations.ok_text : "";
                            color: CediniaColors.fg_on_accent;
                            font-size: Fonts.body_lg; font-weight: Fonts.bold;
                            horizontal-alignment: TextHorizontalAlignment.center;
                            vertical-alignment:   TextVerticalAlignment.center;
                        }
                    }
                }
            }

            // Split mode
            if compare_mode == CompareMode.Split: Rectangle {
                width: parent.width; height: parent.height;
                background: CediniaColors.bg_surface;

                // Left image - clipped to split position
                Rectangle {
                    clip: true;
                    x: 0; y: 0;
                    width: main_area.width * root.slider_value;
                    height: main_area.height;
                    Image {
                        x: 0; y: 0;
                        width: main_area.width; height: main_area.height;
                        source: AppState.compare_left_image;
                        image-fit: ImageFit.contain;
                    }
                }

                // Right image - clipped from split position
                Rectangle {
                    clip: true;
                    x: main_area.width * root.slider_value; y: 0;
                    width: main_area.width * (1.0 - root.slider_value);
                    height: main_area.height;
                    Image {
                        x: -(main_area.width * root.slider_value); y: 0;
                        width: main_area.width; height: main_area.height;
                        source: AppState.compare_right_image;
                        image-fit: ImageFit.contain;
                    }
                }

                // Static split divider line
                Rectangle {
                    x: main_area.width * root.slider_value; y: 0;
                    width: 2px; height: main_area.height;
                    background: CediniaColors.split_line;
                }
            }

            // Overlay mode
            if compare_mode == CompareMode.Overlay: Rectangle {
                width: parent.width; height: parent.height;
                background: CediniaColors.bg_surface;
                Image {
                    width: parent.width; height: parent.height;
                    source: AppState.compare_left_image;
                    image-fit: ImageFit.contain;
                }
                Image {
                    width: parent.width; height: parent.height;
                    source: AppState.compare_right_image;
                    image-fit: ImageFit.contain;
                    opacity: root.slider_value;
                }
            }

            // Diff mode
            if compare_mode == CompareMode.Diff: Rectangle {
                width: parent.width; height: parent.height;
                background: CediniaColors.compare_diff_bg;
                Image {
                    width: parent.width; height: parent.height;
                    source: AppState.compare_diff_image;
                    image-fit: ImageFit.contain;
                    image-rendering: ImageRendering.pixelated;
                }
                if AppState.compare_diff_image.width == 0: Text {
                    text: Translations.compare_computing_text;
                    color: CediniaColors.text_disabled;
                    font-size: Fonts.subtitle;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment:   TextVerticalAlignment.center;
                }
            }
        }

        // Slider row (split or overlay mode)
        if compare_mode == CompareMode.Split || compare_mode == CompareMode.Overlay: Rectangle {
            height: 52px;
            background: CediniaColors.bg_elevated;

            // Top border
            Rectangle {
                x: 0; y: 0; width: parent.width; height: 1px;
                background: CediniaColors.divider;
            }

            HorizontalLayout {
                padding: 12px; spacing: 10px;
                Slider {
                    horizontal-stretch: 1.0;
                    value: root.slider_value;
                    minimum: 0.0; maximum: 1.0;
                    changed(v) => { root.slider_value = v; }
                }
            }
        }

        // Info panel
        if info_visible: Rectangle {
            height: info_content.preferred-height + 16px;
            background: CediniaColors.bg_elevated;

            // Top border
            Rectangle {
                x: 0; y: 0; width: parent.width; height: 1px;
                background: CediniaColors.divider;
            }

            info_content := HorizontalLayout {
                y: 8px; x: 0;
                width: parent.width;
                padding-left: 12px; padding-right: 12px;
                spacing: 8px;

                // Left image info
                VerticalLayout {
                    horizontal-stretch: 1.0;
                    spacing: 2px; alignment: LayoutAlignment.start;

                    Text {
                        text: left_valid ? AppState.compare_images[AppState.compare_left_idx].name : "";
                        color: CediniaColors.accent_light;
                        font-size: Fonts.caption; font-weight: Fonts.bold;
                        overflow: TextOverflow.elide; wrap: no-wrap;
                    }
                    Text {
                        text: left_valid ? AppState.compare_images[AppState.compare_left_idx].size : "";
                        color: CediniaColors.text_secondary;
                        font-size: Fonts.micro;
                    }
                    Text {
                        text: left_valid ? AppState.compare_images[AppState.compare_left_idx].dims : "";
                        color: CediniaColors.text_disabled;
                        font-size: Fonts.micro;
                    }
                    Text {
                        text: left_valid ? AppState.compare_images[AppState.compare_left_idx].dir : "";
                        color: CediniaColors.text_disabled;
                        font-size: Fonts.micro;
                        overflow: TextOverflow.elide; wrap: no-wrap;
                    }
                }

                Rectangle { width: 1px; background: CediniaColors.divider; }

                // Right image info
                VerticalLayout {
                    horizontal-stretch: 1.0;
                    spacing: 2px; alignment: LayoutAlignment.start;

                    Text {
                        text: right_valid ? AppState.compare_images[AppState.compare_right_idx].name : "";
                        color: CediniaColors.accent_light;
                        font-size: Fonts.caption; font-weight: Fonts.bold;
                        overflow: TextOverflow.elide; wrap: no-wrap;
                    }
                    Text {
                        text: right_valid ? AppState.compare_images[AppState.compare_right_idx].size : "";
                        color: CediniaColors.text_secondary;
                        font-size: Fonts.micro;
                    }
                    Text {
                        text: right_valid ? AppState.compare_images[AppState.compare_right_idx].dims : "";
                        color: CediniaColors.text_disabled;
                        font-size: Fonts.micro;
                    }
                    Text {
                        text: right_valid ? AppState.compare_images[AppState.compare_right_idx].dir : "";
                        color: CediniaColors.text_disabled;
                        font-size: Fonts.micro;
                        overflow: TextOverflow.elide; wrap: no-wrap;
                    }
                }
            }
        }

        // Mode selector
        Rectangle {
            height: 48px;
            background: CediniaColors.bg_elevated;

            // Top border
            Rectangle {
                x: 0; y: 0; width: parent.width; height: 1px;
                background: CediniaColors.divider;
            }

            HorizontalLayout {
                alignment: LayoutAlignment.center;
                spacing: 6px;
                padding: 6px;

                // Side-by-side
                Rectangle {
                    width: mode_normal_txt.preferred-width + 24px; height: 36px;
                    border-radius: 8px;
                    background: compare_mode == CompareMode.Normal ? CediniaColors.accent_muted : (mode_normal_ta.has-hover ? CediniaColors.bg_surface : transparent);
                    animate background { duration: 100ms; }
                    mode_normal_ta := TouchArea { clicked => { root.compare_mode = CompareMode.Normal; } }
                    mode_normal_txt := Text {
                        text: Translations.compare_mode_normal_text;
                        color: compare_mode == CompareMode.Normal ? CediniaColors.accent_light : CediniaColors.text_secondary;
                        font-size: Fonts.body; font-weight: Fonts.semibold;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment:   TextVerticalAlignment.center;
                    }
                }

                // Split
                Rectangle {
                    width: mode_split_txt.preferred-width + 24px; height: 36px;
                    border-radius: 8px;
                    background: compare_mode == CompareMode.Split ? CediniaColors.accent_muted : (mode_split_ta.has-hover ? CediniaColors.bg_surface : transparent);
                    animate background { duration: 100ms; }
                    mode_split_ta := TouchArea { clicked => { root.compare_mode = CompareMode.Split; } }
                    mode_split_txt := Text {
                        text: Translations.compare_mode_split_text;
                        color: compare_mode == CompareMode.Split ? CediniaColors.accent_light : CediniaColors.text_secondary;
                        font-size: Fonts.body; font-weight: Fonts.semibold;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment:   TextVerticalAlignment.center;
                    }
                }

                // Overlay
                Rectangle {
                    width: mode_overlay_txt.preferred-width + 24px; height: 36px;
                    border-radius: 8px;
                    background: compare_mode == CompareMode.Overlay ? CediniaColors.accent_muted : (mode_overlay_ta.has-hover ? CediniaColors.bg_surface : transparent);
                    animate background { duration: 100ms; }
                    mode_overlay_ta := TouchArea { clicked => { root.compare_mode = CompareMode.Overlay; } }
                    mode_overlay_txt := Text {
                        text: Translations.compare_mode_overlay_text;
                        color: compare_mode == CompareMode.Overlay ? CediniaColors.accent_light : CediniaColors.text_secondary;
                        font-size: Fonts.body; font-weight: Fonts.semibold;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment:   TextVerticalAlignment.center;
                    }
                }

                // Diff
                Rectangle {
                    width: mode_diff_txt.preferred-width + 24px; height: 36px;
                    border-radius: 8px;
                    background: compare_mode == CompareMode.Diff ? CediniaColors.accent_muted : (mode_diff_ta.has-hover ? CediniaColors.bg_surface : transparent);
                    animate background { duration: 100ms; }
                    mode_diff_ta := TouchArea {
                        clicked => {
                            root.compare_mode = CompareMode.Diff;
                            if (!AppState.compare_loading) { AppState.compare_compute_diff(); }
                        }
                    }
                    mode_diff_txt := Text {
                        text: Translations.compare_mode_diff_text;
                        color: compare_mode == CompareMode.Diff ? CediniaColors.accent_light : CediniaColors.text_secondary;
                        font-size: Fonts.body; font-weight: Fonts.semibold;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment:   TextVerticalAlignment.center;
                    }
                }

                // Score-based delete of the whole group - opens the same dialog as before, but
                // lives with the view-mode pills instead of the progress strip. Enabled only once
                // every image of the group is scored.
                Rectangle {
                    width: score_txt.preferred-width + 24px; height: 36px;
                    border-radius: 8px;
                    background: !AppState.compare_all_rated ? CediniaColors.bg_surface
                        : (score_ta.has-hover ? CediniaColors.danger.brighter(0.15) : CediniaColors.danger);
                    animate background { duration: 100ms; }
                    score_ta := TouchArea {
                        enabled: AppState.compare_all_rated;
                        clicked => { AppState.compare_score_delete_open(); }
                    }
                    score_txt := Text {
                        text: Translations.compare_score_button_text;
                        color: AppState.compare_all_rated ? CediniaColors.fg_on_danger : CediniaColors.text_disabled;
                        font-size: Fonts.body; font-weight: Fonts.semibold;
                        horizontal-alignment: TextHorizontalAlignment.center;
                        vertical-alignment:   TextVerticalAlignment.center;
                    }
                }
            }
        }

        // Scoring progress of the opened group. Hidden until at least one image is scored,
        // so an untouched compare view keeps its usual layout.
        if AppState.compare_rated_count > 0: Rectangle {
            height: 48px;
            background: CediniaColors.bg_elevated;

            Rectangle {
                x: 0; y: 0; width: parent.width; height: 1px;
                background: CediniaColors.divider;
            }

            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                spacing: 8px;

                Text {
                    horizontal-stretch: 1.0;
                    vertical-alignment: TextVerticalAlignment.center;
                    text: Translations.compare_score_progress_text + " " + AppState.compare_rated_count + " / " + AppState.compare_images.length;
                    color: AppState.compare_all_rated ? CediniaColors.success : CediniaColors.text_secondary;
                    font-size: Fonts.caption;
                    overflow: TextOverflow.elide; wrap: no-wrap;
                }
            }
        }

        // Thumbnail strip
        Rectangle {
            height: 118px;
            background: CediniaColors.bg_primary;

            // Top border
            Rectangle {
                x: 0; y: 0; width: parent.width; height: 1px;
                background: CediniaColors.divider;
            }

            ScrollView {
                y: 1px;
                height: parent.height - 1px;
                viewport-width: AppState.compare_images.length * 96px + 8px;

                HorizontalLayout {
                    width: AppState.compare_images.length * 96px + 8px;
                    alignment: LayoutAlignment.start;
                    spacing: 4px;
                    padding: 6px;

                    for img[idx] in AppState.compare_images: VerticalLayout {
                        width: 88px;
                        spacing: 3px;

                        // Thumbnail tile
                        Rectangle {
                            height: 66px;
                            border-radius: 7px;
                            border-width: 2px;
                            border-color:
                                idx == AppState.compare_left_idx  ? CediniaColors.accent_light :
                                idx == AppState.compare_right_idx ? CediniaColors.compare_right_mark : transparent;
                            background: CediniaColors.bg_surface;
                            clip: true;

                            Image {
                                x: 2px; y: 2px;
                                width: parent.width - 4px;
                                height: parent.height - 4px;
                                source: img.thumbnail;
                                image-fit: ImageFit.contain;
                            }

                            // Score badge (top-left) - shown only on scored images
                            if img.rated: Rectangle {
                                x: 4px; y: 4px;
                                width: 20px; height: 20px;
                                border-radius: 10px;
                                background: CediniaColors.accent;
                                Text {
                                    text: "" + img.score;
                                    color: CediniaColors.fg_on_accent;
                                    font-size: Fonts.micro; font-weight: Fonts.bold;
                                    horizontal-alignment: TextHorizontalAlignment.center;
                                    vertical-alignment:   TextVerticalAlignment.center;
                                }
                            }


                            // Checked badge - coloured dot only at this size
                            if img.checked: Rectangle {
                                x: parent.width - 22px; y: 4px;
                                width: 18px; height: 18px;
                                border-radius: 9px;
                                background: CediniaColors.accent;
                            }
                        }

                        // L / R buttons
                        HorizontalLayout {
                            height: 26px; spacing: 3px;

                            Rectangle {
                                horizontal-stretch: 1.0;
                                border-radius: 5px;
                                background: idx == AppState.compare_left_idx
                                    ? CediniaColors.accent
                                    : (l_ta.has-hover ? CediniaColors.bg_surface : CediniaColors.bg_surface);
                                l_ta := TouchArea {
                                    enabled: idx != AppState.compare_right_idx;
                                    clicked => { AppState.compare_set_left(idx); }
                                }
                                Text {
                                    text: "L";
                                    color: idx == AppState.compare_left_idx ? CediniaColors.fg_on_accent : CediniaColors.text_secondary;
                                    font-size: Fonts.body; font-weight: Fonts.bold;
                                    horizontal-alignment: TextHorizontalAlignment.center;
                                    vertical-alignment:   TextVerticalAlignment.center;
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1.0;
                                border-radius: 5px;
                                background: idx == AppState.compare_right_idx
                                    ? CediniaColors.compare_right_mark
                                    : CediniaColors.bg_surface;
                                r_ta := TouchArea {
                                    enabled: idx != AppState.compare_left_idx;
                                    clicked => { AppState.compare_set_right(idx); }
                                }
                                Text {
                                    text: "R";
                                    color: idx == AppState.compare_right_idx ? CediniaColors.fg_on_accent : CediniaColors.text_secondary;
                                    font-size: Fonts.body; font-weight: Fonts.bold;
                                    horizontal-alignment: TextHorizontalAlignment.center;
                                    vertical-alignment:   TextVerticalAlignment.center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Score-based delete: the dialog and the feedback it needs.  They live in this
    // overlay because the results list, with its own delete dialogs, is underneath.
    if AppState.compare_score_delete_visible: ScrimDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        z: 130;
        strong_scrim: true;
        dismissible: !AppState.compare_score_delete_running;
        dismissed => { AppState.compare_score_delete_close(); }
        card_max_width: 360px;
        side_margin: 32px;
        card_radius: 14px;
        card_padding: 20px;
        card_spacing: 12px;
        shadow_color: CediniaColors.shadow_xl;

        Text {
            text: Translations.compare_score_dialog_title_text;
            color: CediniaColors.danger;
            font-size: Fonts.title;
            font-weight: Fonts.bold;
            horizontal-alignment: TextHorizontalAlignment.center;
        }

        Text {
            text: Translations.compare_score_dialog_hint_text;
            color: CediniaColors.text_secondary;
            font-size: Fonts.caption;
            wrap: TextWrap.word-wrap;
            horizontal-alignment: TextHorizontalAlignment.center;
        }

        // Limit - typed on the number keyboard, or stepped with the buttons.
        HorizontalLayout {
            spacing: 8px;

            Text {
                horizontal-stretch: 1.0;
                vertical-alignment: TextVerticalAlignment.center;
                text: Translations.compare_score_dialog_limit_text + " (" + AppState.compare_score_min + " - " + AppState.compare_score_max + ")";
                color: CediniaColors.text_secondary;
                font-size: Fonts.caption;
                wrap: TextWrap.word-wrap;
            }

            Rectangle {
                width: 40px; height: 40px;
                border-radius: 9px;
                background: limit_minus_ta.has-hover ? CediniaColors.bg_surface.brighter(0.15) : CediniaColors.bg_surface;
                limit_minus_ta := TouchArea {
                    enabled: !AppState.compare_score_delete_running;
                    clicked => { AppState.compare_score_delete_limit_step(-1); }
                }
                Text {
                    text: "-";
                    color: CediniaColors.text_primary;
                    font-size: Fonts.title; font-weight: Fonts.bold;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment:   TextVerticalAlignment.center;
                }
            }

            Rectangle {
                width: 76px; height: 40px;
                border-radius: 9px;
                background: CediniaColors.bg_surface;
                border-width: 1px;
                border-color: limit_input.has-focus ? CediniaColors.accent : CediniaColors.divider;

                limit_input := TextInput {
                    x: 8px; y: 6px;
                    width: parent.width - 16px;
                    height: parent.height - 12px;
                    text: AppState.compare_score_delete_limit_text;
                    input-type: InputType.number;
                    color: CediniaColors.text_primary;
                    font-size: Fonts.title_lg;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment:   TextVerticalAlignment.center;
                    edited => { AppState.compare_score_delete_limit_edited(self.text); }
                    accepted => { AppState.compare_score_delete_limit_edited(self.text); }
                }
            }

            Rectangle {
                width: 40px; height: 40px;
                border-radius: 9px;
                background: limit_plus_ta.has-hover ? CediniaColors.bg_surface.brighter(0.15) : CediniaColors.bg_surface;
                limit_plus_ta := TouchArea {
                    enabled: !AppState.compare_score_delete_running;
                    clicked => { AppState.compare_score_delete_limit_step(1); }
                }
                Text {
                    text: "+";
                    color: CediniaColors.text_primary;
                    font-size: Fonts.title; font-weight: Fonts.bold;
                    horizontal-alignment: TextHorizontalAlignment.center;
                    vertical-alignment:   TextVerticalAlignment.center;
                }
            }
        }

        Text {
            text: Translations.compare_score_dialog_count_text + ": " + AppState.compare_score_delete_count;
            color: AppState.compare_score_delete_count > 0 ? CediniaColors.danger : CediniaColors.text_secondary;
            font-size: Fonts.body_lg; font-weight: Fonts.semibold;
            horizontal-alignment: TextHorizontalAlignment.center;
        }

        if AppState.compare_score_delete_count == 0: Text {
            text: Translations.compare_score_dialog_none_text;
            color: CediniaColors.text_secondary;
            font-size: Fonts.caption;
            wrap: TextWrap.word-wrap;
            horizontal-alignment: TextHorizontalAlignment.center;
        }

        if AppState.compare_score_delete_running: Text {
            text: AppState.compare_score_delete_progress_text;
            color: CediniaColors.text_secondary;
            font-size: Fonts.body_lg;
            horizontal-alignment: TextHorizontalAlignment.center;
        }

        HorizontalLayout {
            spacing: 8px;

            TouchButton {
                label: Translations.cancel_text;
                horizontal-stretch: 1.0;
                min_h: 44px;
                bg: CediniaColors.bg_surface;
                fg: CediniaColors.text_secondary;
                enabled: !AppState.compare_score_delete_running;
                clicked => { AppState.compare_score_delete_close(); }
            }

            TouchButton {
                label: Translations.delete_text;
                horizontal-stretch: 1.0;
                min_h: 44px;
                bg: CediniaColors.danger;
                fg: CediniaColors.fg_on_danger;
                enabled: AppState.compare_score_delete_count > 0 && !AppState.compare_score_delete_running;
                clicked => { AppState.compare_score_delete_confirm(); }
            }
        }
    }


    // Delete failures from either the viewer or the score-based delete - the results
    // list shows its own dialog, which this overlay covers.
    if AppState.delete_errors_visible: ScrimDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        z: 140;
        strong_scrim: true;
        dismissible: false;
        card_max_width: 400px;
        side_margin: 32px;
        card_radius: 14px;
        card_padding: 20px;
        card_spacing: 12px;
        shadow_color: CediniaColors.shadow_xl;

        Text {
            text: Translations.delete_errors_title_text;
            color: CediniaColors.warning;
            font-size: Fonts.label_lg;
            font-weight: Fonts.semibold;
            wrap: TextWrap.word-wrap;
            horizontal-alignment: TextHorizontalAlignment.center;
        }

        Text {
            text: AppState.delete_errors_text;
            color: CediniaColors.text_secondary;
            font-size: Fonts.caption;
            wrap: TextWrap.word-wrap;
        }

        TouchButton {
            label: Translations.ok_text;
            min_h: 44px;
            bg: CediniaColors.bg_surface;
            fg: CediniaColors.text_secondary;
            clicked => { AppState.delete_errors_visible = false; }
        }
    }


    // Loading overlay
    if AppState.compare_loading: ScrimDialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        z: 100;
        strong_scrim: true;
        dismissible: false;
        card_max_width: 280px;
        card_spacing: 12px;
        shadow_blur: 20px;
        shadow_color: CediniaColors.shadow_lg;

        Text {
            text: AppState.compare_cancelling
                ? Translations.compare_cancelling_text
                : Translations.compare_loading_text;
            color: CediniaColors.text_primary;
            font-size: Fonts.label_lg; font-weight: Fonts.semibold;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        Text {
            text: AppState.compare_loading_current + " / " + AppState.compare_loading_total;
            color: CediniaColors.text_secondary;
            font-size: Fonts.body_lg;
            horizontal-alignment: TextHorizontalAlignment.center;
        }
        Rectangle {
            height: 40px;
            border-radius: 8px;
            background: cancel_ta.has-hover ? CediniaColors.bg_surface.brighter(0.1) : CediniaColors.bg_surface;
            cancel_ta := TouchArea {
                enabled: !AppState.compare_cancelling;
                clicked => { AppState.compare_cancel_load(); }
            }
            Text {
                text: Translations.cancel_text;
                color: AppState.compare_cancelling ? CediniaColors.text_disabled : CediniaColors.text_secondary;
                font-size: Fonts.subtitle;
                horizontal-alignment: TextHorizontalAlignment.center;
                vertical-alignment:   TextVerticalAlignment.center;
            }
        }
    }

    // Fullscreen single image viewer - above the loading overlay, because deleting an
    // image reloads the group underneath it.
    if AppState.compare_fullscreen_visible: CompareFullscreen {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        z: 110;
    }
}
